+
+/// 「上下文」页：粘贴一段聊天记录 → 生成层压缩成「关系摘要」→ 存共享容器。
+/// 键盘每次分析自动携带摘要（判断与起草都吃 context 槽）；原文只用于本次压缩，不落盘。
+struct ContextView: View {
+    @EnvironmentObject private var store: ConfigStore
+    @State private var rawInput = ""
+    @State private var summary = JevStore.contextSummary
+    @State private var busy = false
+    @State private var notice: String?
+
+    var body: some View {
+        Form {
+            Section {
+                TextEditor(text: $summary)
+                    .frame(minHeight: 110)
+                    .font(.callout)
+                    .autocorrectionDisabled()
+                    .onChange(of: summary) { _ in JevStore.contextSummary = summary }
+            } header: {
+                Text(jevLocalized(store.language, zh: "关系摘要（键盘自动携带）", en: "Relationship summary (auto-attached)"))
+            } footer: {
+                Text(jevLocalized(store.language, zh: "键盘每次分析都会把这段摘要连同消息一起送给模型；留空 = 不带上下文，改动即时生效。", en: "Attached to every analysis. Empty = no context. Edits apply immediately."))
+            }
+
+            Section {
+                TextEditor(text: $rawInput)
+                    .frame(minHeight: 110)
+                    .font(.callout)
+                    .autocorrectionDisabled()
+                Button {
+                    summarize()
+                } label: {
+                    HStack {
+                        Image(systemName: "wand.and.stars")
+                        Text(jevLocalized(store.language, zh: "生成摘要", en: "Summarize"))
+                    }
+                }
+                .disabled(busy || rawInput.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty)
+                if busy {
+                    HStack(spacing: 8) {
+                        ProgressView()
+                        Text(jevLocalized(store.language, zh: "压缩中…", en: "Summarizing…"))
+                            .font(.caption).foregroundStyle(.secondary)
+                    }
+                }
+                if let notice {
+                    Text(notice).font(.caption).foregroundStyle(.secondary)
+                }
+            } header: {
+                Text(jevLocalized(store.language, zh: "从聊天记录生成", en: "Generate from chat history"))
+            } footer: {
+                Text(jevLocalized(store.language, zh: "微信里长按消息 → 多选 → 合并转发 → 复制，粘贴到上面点「生成摘要」。原文只用于本次压缩，不会保存。", en: "Paste chat history (WeChat: select → merge forward → copy) and tap Summarize. The raw text is not stored."))
+            }
+        }
+        .navigationTitle(jevLocalized(store.language, zh: "上下文", en: "Context"))
+    }
+
+    private func summarize() {
+        let raw = String(rawInput.trimmingCharacters(in: .whitespacesAndNewlines).prefix(6000))
+        guard !raw.isEmpty else { return }
+        busy = true
+        notice = nil
+        let prompt = """
+        下面是一段聊天记录。请把它压缩成一份不超过 200 字的「关系摘要」，作为后续针对单条新消息生成回复时的背景信息。要求：
+        1. 只输出摘要正文：不要标题、不要序号、不要任何解释。
+        2. 覆盖：对方是谁/怎么称呼、关系与当前氛围、最近在聊什么、有没有没聊完的话题或约定、雷区和注意点、两人的梗或惯用称呼。
+        3. 平实的陈述句，人名和称呼保留原样。
+
+        聊天记录：
+        \(raw)
+        """
+        let draft = JevDraft(cfg: store.config)
+        Task { @MainActor in
+            defer { busy = false }
+            do {
+                let out = try await draft.call(prompt: prompt)
+                let cleaned = out.trimmingCharacters(in: .whitespacesAndNewlines)
+                guard !cleaned.isEmpty else { throw JevError.emptyReply }
+                summary = cleaned
+                JevStore.contextSummary = cleaned
+                rawInput = ""
+                notice = jevLocalized(store.language, zh: "已生成摘要并保存（原文未保留）", en: "Summary saved (raw text discarded)")
+            } catch {
+                notice = jevLocalized(store.language, zh: "生成失败：", en: "Failed: ") + error.localizedDescription
+            }
+        }
+    }
+}
